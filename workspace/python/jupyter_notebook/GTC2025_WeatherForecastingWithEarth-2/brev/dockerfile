#
# Brev launchable image for the GTC2025 "Applying AI Weather Models with
# NVIDIA Earth-2" workshop. Builds *on top of* the official NVIDIA PhysicsNeMo
# container and installs the workshop dependencies + Earth-2 data. Nothing is
# pushed to a registry - Brev builds this locally on the instance from the
# PhysicsNeMo base via docker compose.
#
# This mirrors the workshop's own ../Dockerfile (makani, torch-harmonics,
# earth2studio extras, plotting libs, Earth-2 cache) but on the PhysicsNeMo
# 26.05 base instead of the plain PyTorch base.
#
# The docker build context is the workshop directory (brev/..), so the image
# contains only this course.
#
# Base image: https://catalog.ngc.nvidia.com/orgs/nvidia/teams/physicsnemo/containers/physicsnemo

FROM nvcr.io/nvidia/physicsnemo/physicsnemo:26.05

# --- Environment ---------------------------------------------------------------
ENV DEBIAN_FRONTEND=noninteractive \
    SHELL=/bin/bash \
    PIP_ROOT_USER_ACTION=ignore \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HDF5_USE_FILE_LOCKING=FALSE \
    LOGURU_LEVEL=INFO \
    EARTH2STUDIO_CACHE=/workspace/data/earth2cache \
    EARTH2STUDIO_PACKAGE_TIMEOUT=600 \
    NGC_CLI_ORG=no-org \
    NGC_CLI_TEAM=no-team \
    COURSE_DIR=/workspace/dli

# --- System dependencies -------------------------------------------------------
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    ffmpeg \
    git \
    libgl1 \
    libglx-mesa0 \
    libegl1 \
 && apt-get clean -y \
 && rm -rf /var/lib/apt/lists/*

# --- Python dependencies -------------------------------------------------------
# Simple/pinned packages via requirements.txt (copied first for layer caching).
COPY brev/requirements.txt /opt/requirements.txt
RUN pip install --no-cache-dir -r /opt/requirements.txt \
 && rm -f /opt/requirements.txt \
 && jupyter labextension disable "@jupyterlab/apputils-extension:announcements" || true

# Git-based packages, pinned to the same revisions as the workshop ../Dockerfile.
# torch-harmonics needs torch present at build time -> --no-build-isolation.
RUN pip install --no-cache-dir --no-build-isolation \
    "torch-harmonics @ git+https://github.com/NVIDIA/torch-harmonics.git@a632ca748a12bd9f74dbc1e00653317810991f74"
RUN pip install --no-cache-dir \
    "makani @ git+https://github.com/NVIDIA/makani.git@b38fcb2799d7dbc146fa60459f3f9823394a8bf1"
RUN pip install --no-cache-dir \
    "earth2studio[data,corrdiff,perturbation,sfno] @ git+https://github.com/NVIDIA/earth2studio.git@0.14.0"
# Prefer nvidia-ml-py over the deprecated pynvml (matches the workshop Dockerfile).
RUN pip install --no-cache-dir nvidia-ml-py && pip uninstall -y pynvml || true

# --- Workshop materials --------------------------------------------------------
# Build context is the workshop directory; copy it in (minus this brev/ folder).
COPY . /workspace/dli
RUN rm -rf /workspace/dli/brev

# --- Earth-2 data prefetch -----------------------------------------------------
# fetch_data.py  -> cartopy coastlines + windpowerlib turbine data (plotting)
# fetch_cache.py -> SFNO + CorrDiff-Taiwan checkpoints and the GFS/ERA5/WB2
#                   weather slices used by the workshop notebooks, cached into
#                   EARTH2STUDIO_CACHE. Public sources, no credentials required.
# Set PREFETCH_EARTH2_DATA=0 at build time to skip the (multi-GB) download.
ARG PREFETCH_EARTH2_DATA=1
RUN mkdir -p "$EARTH2STUDIO_CACHE" \
 && if [ "$PREFETCH_EARTH2_DATA" = "1" ]; then \
      echo "Prefetching Earth-2 plotting assets + model/weather cache ..." \
      && python /workspace/dli/data/fetch_data.py \
      && python /workspace/dli/data/fetch_cache.py ; \
    else \
      echo "Skipping Earth-2 data prefetch (PREFETCH_EARTH2_DATA=$PREFETCH_EARTH2_DATA)" ; \
    fi

WORKDIR /workspace/dli
EXPOSE 8888

COPY brev/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
