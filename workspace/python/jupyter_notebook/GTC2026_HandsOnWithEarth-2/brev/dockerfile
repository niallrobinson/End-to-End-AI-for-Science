#
# Brev launchable image for the GTC2026 "Hands-On with Earth-2" (StormCast)
# workshop. Builds *on top of* the official NVIDIA PhysicsNeMo container and
# installs the workshop dependencies. Nothing is pushed to a registry - Brev
# builds this locally on the instance from the PhysicsNeMo base via docker
# compose.
#
# This mirrors the workshop's own ../Dockerfile: JupyterLab in the base Python,
# plus an isolated `uv` virtual environment holding the pinned workshop stack
# (earth2studio 0.12.1, nvidia-physicsnemo 1.3.0, StormCast training deps),
# registered as a Jupyter kernel named "physicsnemo".
#
# The docker build context is the workshop directory (brev/..), so the image
# contains only this course. Weather data (HRRR/ERA5) is downloaded at runtime
# by the workshop scripts/notebooks - nothing is prefetched here, matching the
# upstream Dockerfile.
#
# Base image: https://catalog.ngc.nvidia.com/orgs/nvidia/teams/physicsnemo/containers/physicsnemo

FROM nvcr.io/nvidia/physicsnemo/physicsnemo:25.11

# --- Environment ---------------------------------------------------------------
ENV PYTHONPATH="/physicsnemo:${PYTHONPATH}" \
    DEBIAN_FRONTEND=noninteractive \
    SHELL=/bin/bash \
    PIP_ROOT_USER_ACTION=ignore \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# --- JupyterLab (base Python) --------------------------------------------------
# Copied first for layer caching. Mirrors the workshop Dockerfile's jupyter pin.
COPY brev/requirements.txt /opt/requirements.txt
RUN pip install --no-cache-dir -r /opt/requirements.txt \
 && rm -f /opt/requirements.txt \
 && rm -rf /root/.jupyter \
 && jupyter labextension disable "@jupyterlab/apputils-extension:announcements" || true

# --- System dependencies -------------------------------------------------------
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    libgl1 \
    libglx-mesa0 \
    libegl1 \
    xvfb \
    git \
 && apt-get clean -y \
 && rm -rf /var/lib/apt/lists/*

# --- Workshop environment (isolated uv venv + kernel) --------------------------
# Mirrors the workshop ../Dockerfile: an isolated uv venv pins the workshop's
# earth2studio / physicsnemo / training stack without disturbing the base
# container, and is registered as the Jupyter kernel "physicsnemo".
RUN pip install --no-cache-dir uv \
 && cd /root && uv init --python=3.12 \
 && uv add "earth2studio @ git+https://github.com/NVIDIA/earth2studio.git@0.12.1" --extra sfno \
 && uv add torch-optimi pyproj matplotlib cartopy omegaconf hydra-core wandb \
    nvidia-ml-py jupyter ipywidgets \
    tensorboard nvtx termcolor scipy setuptools==81.0.0 \
    nvidia-physicsnemo==1.3.0 \
 && uv pip install nvidia-ml-py && uv pip uninstall pynvml \
 && uv add ipykernel && uv run python -m ipykernel install --user --name=physicsnemo

# --- Workshop materials --------------------------------------------------------
# Build context is the workshop directory; copy it in (minus this brev/ folder).
COPY . /dli/workshop
RUN rm -rf /dli/workshop/brev

WORKDIR /dli/workshop
EXPOSE 8888

COPY brev/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
